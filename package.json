    "prepare": "tsc"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "linkedom": "^0.18.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.48.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "keywords": [
    "playwright",
    "test-automation",
    "self-healing",
    "qa",
    "e2e",
    "jira",
    "ci-cd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annikasu8/kasuwright.git"
  },
  "homepage": "https://github.com/annikasu8/kasuwright#readme",
