{
  "name": "kasuwright",
  "version": "0.8.0",
  "description": "AI-ready self-healing locators and failure analysis for Playwright test suites",
  "type": "module",
  "bin": {
    "kasuwright": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "demo": "npm run build && node dist/src/demo.js",
